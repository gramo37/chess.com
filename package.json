{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma",
    "seed": "tsx packages/database/src/seed.ts"
  },
  "scripts": {
    "build": "turbo run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "install:frontend": "cd apps/frontend && npm install",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "dev": "turbo run dev",
    "prod": "turbo run prod",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "setup:backend": "cp ./apps/backend/.env.example ./apps/backend/.env",
    "setup:db": "cp .env.example ./packages/db/prisma/.env",
    "setup:ws": "cp ./apps/ws/.env.example ./apps/ws/.env",
    "setup:frontend": "cp ./apps/frontend/.env.example ./apps/frontend/.env",
    "setup:env": "npm run setup:backend && npm run setup:db && npm run setup:ws && npm run setup:frontend",
    "dev:setup": "npm run setup:env && npm install && npm run generate && npm run build -w backend",
    "clean": "rm -rf node_modules .env .turbo build"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.4.0"
}
